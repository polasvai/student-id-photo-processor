@page "/"
@rendermode InteractiveServer
@inject IBatchProcessingService BatchService
@inject IOnnxModelBootstrapper Bootstrapper
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Student ID Photo Processor</PageTitle>

<div class="row g-4">
    <!-- Left Column: Settings & Upload -->
    <div class="col-lg-4 col-xl-3">
        <!-- Model Status Banner -->
        <div class="card shadow-sm border-0 mb-3 @(Bootstrapper.AreModelsReady ? "bg-white" : "border-warning border-1")">
            <div class="card-body py-2 px-3 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <span class="spinner-grow spinner-grow-sm text-warning" role="status" style="@(Bootstrapper.AreModelsReady ? "display:none;" : "")"></span>
                    <span class="badge @(Bootstrapper.AreModelsReady ? "bg-success" : "bg-warning text-dark")">
                        @(Bootstrapper.AreModelsReady ? "AI Models Ready" : "Initializing Models...")
                    </span>
                </div>
                <button class="btn btn-sm btn-link text-decoration-none py-0 px-1" @onclick="CheckModelStatus" title="Refresh Model Status">
                    ↻ Refresh
                </button>
            </div>
            @if (!Bootstrapper.AreModelsReady)
            {
                <div class="card-footer bg-light py-1 px-3 small text-muted">
                    Downloading ONNX segmentation weights in background...
                </div>
            }
        </div>

        <!-- Configuration Panel -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fw-semibold d-flex align-items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-sliders text-primary" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M11.5 2a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3M9.05 3a2.5 2.5 0 0 1 4.9 0H16v1h-2.05a2.5 2.5 0 0 1-4.9 0H0V3zM4.5 7a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3M2.05 8a2.5 2.5 0 0 1 4.9 0H16v1H6.95a2.5 2.5 0 0 1-4.9 0H0V8zm9.45 4a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3m-2.45 1a2.5 2.5 0 0 1 4.9 0H16v1h-2.05a2.5 2.5 0 0 1-4.9 0H0v-1z"/>
                    </svg>
                    ID Photo Specifications
                </h5>
                <span class="badge bg-light text-dark border">@(Options.TargetWidth)×@(Options.TargetHeight) px</span>
            </div>
            <div class="card-body">
                <!-- Dimensions -->
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label small fw-semibold text-muted">Width (px)</label>
                        <input type="number" class="form-control form-control-sm" @bind="Options.TargetWidth" min="100" max="2000" step="10" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold text-muted">Height (px)</label>
                        <input type="number" class="form-control form-control-sm" @bind="Options.TargetHeight" min="100" max="2000" step="10" />
                    </div>
                </div>

                <!-- Print Resolution (DPI) -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label small fw-semibold text-muted mb-0">Print Resolution (DPI)</label>
                        <span class="badge bg-secondary-subtle text-secondary font-monospace">@Options.TargetDpi DPI</span>
                    </div>
                    <div class="input-group input-group-sm mb-1">
                        <input type="number" class="form-control" @bind="Options.TargetDpi" min="72" max="1200" step="50" placeholder="300" />
                        <span class="input-group-text">DPI</span>
                    </div>
                    <!-- DPI Presets -->
                    <div class="d-flex gap-1 flex-wrap">
                        <button type="button" class="btn btn-xs @(Options.TargetDpi == 300 ? "btn-primary" : "btn-outline-secondary") py-0 px-2" style="font-size: 0.75rem;" @onclick="() => Options.TargetDpi = 300">
                            300 (Print Standard)
                        </button>
                        <button type="button" class="btn btn-xs @(Options.TargetDpi == 600 ? "btn-primary" : "btn-outline-secondary") py-0 px-2" style="font-size: 0.75rem;" @onclick="() => Options.TargetDpi = 600">
                            600 (Ultra High)
                        </button>
                        <button type="button" class="btn btn-xs @(Options.TargetDpi == 150 ? "btn-primary" : "btn-outline-secondary") py-0 px-2" style="font-size: 0.75rem;" @onclick="() => Options.TargetDpi = 150">
                            150 (Draft)
                        </button>
                        <button type="button" class="btn btn-xs @(Options.TargetDpi == 72 ? "btn-primary" : "btn-outline-secondary") py-0 px-2" style="font-size: 0.75rem;" @onclick="() => Options.TargetDpi = 72">
                            72 (Web)
                        </button>
                    </div>
                </div>

                <!-- Background Color Selection & Custom Color Picker -->
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted d-flex justify-content-between align-items-center mb-1">
                        <span>Background Color</span>
                        <span class="d-inline-flex align-items-center gap-1 font-monospace small px-2 py-0 border rounded bg-white">
                            <span class="d-inline-block rounded-circle border" style="width: 12px; height: 12px; background-color: @Options.BgColorHex;"></span>
                            @Options.BgColorHex
                        </span>
                    </label>

                    <!-- Preset Chips -->
                    <div class="d-flex gap-1 flex-wrap mb-2">
                        <button type="button" class="btn btn-sm @(Options.BgColorHex.Equals("#F4F4F4", StringComparison.OrdinalIgnoreCase) ? "btn-dark" : "btn-outline-secondary") d-flex align-items-center gap-1 py-1" @onclick='() => SetColor("#F4F4F4")'>
                            <span class="d-inline-block rounded-circle border" style="width: 12px; height: 12px; background-color: #F4F4F4;"></span>
                            Off-White
                        </button>
                        <button type="button" class="btn btn-sm @(Options.BgColorHex.Equals("#FFFFFF", StringComparison.OrdinalIgnoreCase) ? "btn-dark" : "btn-outline-secondary") d-flex align-items-center gap-1 py-1" @onclick='() => SetColor("#FFFFFF")'>
                            <span class="d-inline-block rounded-circle border" style="width: 12px; height: 12px; background-color: #FFFFFF;"></span>
                            Pure White
                        </button>
                        <button type="button" class="btn btn-sm @(Options.BgColorHex.Equals("#EBF4FA", StringComparison.OrdinalIgnoreCase) ? "btn-dark" : "btn-outline-secondary") d-flex align-items-center gap-1 py-1" @onclick='() => SetColor("#EBF4FA")'>
                            <span class="d-inline-block rounded-circle border" style="width: 12px; height: 12px; background-color: #EBF4FA;"></span>
                            Passport Blue
                        </button>
                        <button type="button" class="btn btn-sm @(Options.BgColorHex.Equals("#003366", StringComparison.OrdinalIgnoreCase) ? "btn-dark" : "btn-outline-secondary") d-flex align-items-center gap-1 py-1" @onclick='() => SetColor("#003366")'>
                            <span class="d-inline-block rounded-circle border" style="width: 12px; height: 12px; background-color: #003366;"></span>
                            Navy Blue
                        </button>
                        <button type="button" class="btn btn-sm @(Options.BgColorHex.Equals("#B71C1C", StringComparison.OrdinalIgnoreCase) ? "btn-dark" : "btn-outline-secondary") d-flex align-items-center gap-1 py-1" @onclick='() => SetColor("#B71C1C")'>
                            <span class="d-inline-block rounded-circle border" style="width: 12px; height: 12px; background-color: #B71C1C;"></span>
                            Red
                        </button>
                    </div>

                    <!-- Custom Color Chooser Input -->
                    <div class="card p-2 bg-light border">
                        <label class="form-label extra-small text-muted mb-1 fw-bold" style="font-size: 0.72rem;">🎨 CUSTOM COLOR PICKER</label>
                        <div class="d-flex align-items-center gap-2">
                            <input type="color" class="form-control form-control-color flex-shrink-0" @bind="Options.BgColorHex" style="width: 44px; height: 34px; cursor: pointer;" title="Click to choose any custom color" />
                            <div class="input-group input-group-sm">
                                <span class="input-group-text font-monospace">Hex</span>
                                <input type="text" class="form-control font-monospace" @bind="Options.BgColorHex" placeholder="#F4F4F4" maxlength="7" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Output Format -->
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted">Output Format</label>
                    <div class="btn-group w-100" role="group">
                        <input type="radio" class="btn-check" name="formatRadio" id="fmtJpeg" checked="@Options.OutputJpeg" @onchange="() => Options.OutputJpeg = true" />
                        <label class="btn btn-outline-primary btn-sm" for="fmtJpeg">JPEG (Q95)</label>

                        <input type="radio" class="btn-check" name="formatRadio" id="fmtPng" checked="@(!Options.OutputJpeg)" @onchange="() => Options.OutputJpeg = false" />
                        <label class="btn btn-outline-primary btn-sm" for="fmtPng">PNG Lossless</label>
                    </div>
                </div>

                <!-- Smart Framing Manual Tuning -->
                <div class="border rounded p-3 mb-3 bg-white">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold small text-dark d-flex align-items-center gap-1">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-crop text-primary" viewBox="0 0 16 16">
                                <path d="M3.5.5A.5.5 0 0 1 4 1v13h13a.5.5 0 0 1 0 1h-2v2a.5.5 0 0 1-1 0v-2H3.5a.5.5 0 0 1-.5-.5V4H1a.5.5 0 0 1 0-1h2V1a.5.5 0 0 1 .5-.5m1 10.5a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-6.5H5a.5.5 0 0 1-.5-.5"/>
                            </svg>
                            Smart Framing Tuning
                        </span>
                        <span class="badge bg-primary-subtle text-primary extra-small" style="font-size: 0.7rem;">Manual Controls</span>
                    </div>

                    <!-- Headroom Slider -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small text-muted mb-1">
                            <span>Headroom Margin:</span>
                            <span class="fw-bold text-dark font-monospace">@Options.HeadroomRatio.ToString("F2")</span>
                        </div>
                        <input type="range" class="form-range" min="0.10" max="0.90" step="0.05" @bind="Options.HeadroomRatio" @bind:event="oninput" />
                        <div class="d-flex justify-content-between extra-small text-muted" style="font-size: 0.7rem;">
                            <span>0.10 (Tight Hair)</span>
                            <span class="text-primary fw-semibold">0.45 (Default)</span>
                            <span>0.90 (Extra Space)</span>
                        </div>
                    </div>

                    <!-- Torso / Shoulder Multiplier Slider -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small text-muted mb-1">
                            <span>Torso & Shoulder Zoom:</span>
                            <span class="fw-bold text-dark font-monospace">@Options.FaceHeightMultiplier.ToString("F2")×</span>
                        </div>
                        <input type="range" class="form-range" min="1.50" max="3.50" step="0.05" @bind="Options.FaceHeightMultiplier" @bind:event="oninput" />
                        <div class="d-flex justify-content-between extra-small text-muted" style="font-size: 0.7rem;">
                            <span>1.50× (Face Close-up)</span>
                            <span class="text-primary fw-semibold">2.35× (Default)</span>
                            <span>3.50× (Wide Bust)</span>
                        </div>
                    </div>

                    <!-- Framing Presets -->
                    <div class="d-flex gap-1 flex-wrap mb-2">
                        <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" style="font-size: 0.72rem;" @onclick="SetFramingDefault">
                            ID Default (0.45 / 2.35×)
                        </button>
                        <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" style="font-size: 0.72rem;" @onclick="SetFramingTight">
                            Passport Tight (0.30 / 1.85×)
                        </button>
                        <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" style="font-size: 0.72rem;" @onclick="SetFramingWide">
                            Wide Bust (0.50 / 2.80×)
                        </button>
                    </div>
                </div>

                <!-- Save & Reset Settings Section -->
                <div class="d-flex gap-2 mb-2">
                    <button type="button" class="btn btn-sm btn-primary flex-grow-1 d-flex align-items-center justify-content-center gap-1" @onclick="SaveSettingsAsync">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-save" viewBox="0 0 16 16">
                            <path d="M2 1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H9.5a1 1 0 0 0-1 1v7.293l2.646-2.647a.5.5 0 0 1 .708.708l-3.5 3.5a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L7.5 9.293V2a2 2 0 0 1 2-2H14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h2.5a.5.5 0 0 1 0 1z"/>
                        </svg>
                        Save as Default
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ResetSettingsAsync" title="Reset all settings to original spec defaults">
                        ↺ Reset
                    </button>
                </div>

                @if (SettingsSavedAlertVisible)
                {
                    <div class="alert alert-success py-1 px-2 small mb-0 d-flex align-items-center gap-1 text-success-emphasis bg-success-subtle border-0">
                        <span>✔ Settings saved to your browser! They will auto-load on every visit.</span>
                    </div>
                }
            </div>
        </div>

        <!-- Batch Summary Info Card -->
        @if (CurrentJobs.Count > 0)
        {
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-semibold">Batch Status</h6>
                    <span class="badge bg-primary">Batch #@CurrentBatchId</span>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-1 small text-muted">
                        <span>Total Uploaded:</span>
                        <span class="fw-bold text-dark">@CurrentJobs.Count</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1 small text-muted">
                        <span>Completed:</span>
                        <span class="fw-bold text-success">@CompletedCount</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1 small text-muted">
                        <span>In Progress:</span>
                        <span class="fw-bold text-warning">@ProcessingCount</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 small text-muted">
                        <span>Failed:</span>
                        <span class="fw-bold text-danger">@FailedCount</span>
                    </div>

                    @if (CompletedCount > 0)
                    {
                        <a href="/api/batch/download/@CurrentBatchId" class="btn btn-success w-100 d-flex align-items-center justify-content-center gap-2 fw-semibold py-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-file-earmark-zip" viewBox="0 0 16 16">
                                <path d="M5 7.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zM4 9.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5zm2 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5z"/>
                                <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5z"/>
                            </svg>
                            Download All as .ZIP (@CompletedCount)
                        </a>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Right Column: Drop Zone & Preview Grid -->
    <div class="col-lg-8 col-xl-9">
        <!-- Drag & Drop Upload Zone -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4 text-center">
                <div class="upload-dropzone p-5 border border-2 border-dashed rounded-3 bg-white position-relative" style="cursor: pointer; transition: all 0.2s ease;">
                    <InputFile OnChange="HandleFileSelected" multiple accept=".jpg,.jpeg,.png,.webp" class="position-absolute top-0 start-0 w-100 h-100 opacity-0" style="cursor: pointer; z-index: 10;" />
                    
                    <div class="mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" fill="currentColor" class="bi bi-cloud-arrow-up text-primary" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M7.646 5.146a.5.5 0 0 1 .708 0l2 2a.5.5 0 0 1-.708.708L8.5 6.707V10.5a.5.5 0 0 1-1 0V6.707L6.354 7.854a.5.5 0 1 1-.708-.708z"/>
                            <path d="M4.406 3.342A5.53 5.53 0 0 1 8 2c2.69 0 4.923 2 5.166 4.579C14.758 6.804 16 8.137 16 9.773 16 11.569 14.502 13 12.687 13H3.781C1.708 13 0 11.366 0 9.318c0-1.763 1.266-3.223 2.942-3.593.143-.863.698-1.723 1.464-2.383m.653.757c-.757.653-1.153 1.44-1.153 2.056v.448l-.445.049C2.064 6.805 1 7.952 1 9.318 1 10.785 2.23 12 3.781 12h8.906C13.98 12 15 10.988 15 9.773c0-1.216-1.02-2.228-2.313-2.228h-.5v-.5C12.188 4.825 10.328 3 8 3a4.53 4.53 0 0 0-2.941 1.1z"/>
                        </svg>
                    </div>
                    <h5 class="fw-bold mb-1">Drag and drop mobile photos here</h5>
                    <p class="text-muted mb-2">Supports batch upload of 1 to 200+ JPG, PNG, or WEBP photos</p>
                    <button type="button" class="btn btn-outline-primary btn-sm px-4 fw-semibold">
                        Browse Files from Computer
                    </button>
                </div>

                @if (IsUploading)
                {
                    <div class="mt-3">
                        <div class="d-flex align-items-center justify-content-center gap-2 text-primary">
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                            <span class="fw-semibold">Reading and enqueueing uploaded files into pipeline...</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Real-Time Progress Bar -->
        @if (CurrentJobs.Count > 0)
        {
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold">
                            @if (IsFinished)
                            {
                                <span class="text-success">✔ Batch processing completed! (@CompletedCount / @CurrentJobs.Count photos ready)</span>
                            }
                            else
                            {
                                <span>Processing Batch: @CompletedCount / @CurrentJobs.Count photos completed (@ProgressPercent%)</span>
                            }
                        </span>
                        <div class="d-flex gap-2">
                            @if (CompletedCount > 0)
                            {
                                <a href="/api/batch/download/@CurrentBatchId" class="btn btn-sm btn-success fw-semibold">
                                    Download .ZIP
                                </a>
                            }
                            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearBatch">Clear</button>
                        </div>
                    </div>
                    <div class="progress" style="height: 12px;">
                        <div class="progress-bar progress-bar-striped progress-bar-animated @(IsFinished ? "bg-success" : "bg-primary")" 
                             role="progressbar" 
                             style="width: @(ProgressPercent)%;" 
                             aria-valuenow="@ProgressPercent" 
                             aria-valuemin="0" 
                             aria-valuemax="100">
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Processed Preview Grid -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">Processed Photos Preview</h5>
            @if (CurrentJobs.Count > 0)
            {
                <span class="text-muted small">Showing @CurrentJobs.Count images</span>
            }
        </div>

        @if (CurrentJobs.Count == 0)
        {
            <div class="card shadow-sm border-0 text-center py-5">
                <div class="card-body text-muted">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-images text-black-50 mb-3" viewBox="0 0 16 16">
                        <path d="M4.502 9a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3"/>
                        <path d="M14.002 13a2 2 0 0 1-2 2h-10a2 2 0 0 1-2-2V5A2 2 0 0 1 2 3a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v8a2 2 0 0 1-1.998 2M14 2H4a1 1 0 0 0-1 1h9.002a2 2 0 0 1 2 2v7A1 1 0 0 0 15 11V3a1 1 0 0 0-1-1M2.002 4a1 1 0 0 0-1 1v8l2.646-2.354a.5.5 0 0 1 .63-.062l2.66 1.773 3.71-3.71a.5.5 0 0 1 .577-.094l1.777 1.947V5a1 1 0 0 0-1-1z"/>
                    </svg>
                    <h6>No photos uploaded yet</h6>
                    <p class="small mb-0">Upload mobile photos above to see automatic face centering, solid background replacement, and 300x300 previews here.</p>
                </div>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-3">
                @foreach (var job in CurrentJobs.DistinctBy(j => j.JobId))
                {
                    <div class="col" @key="job.JobId">
                        <div class="card h-100 shadow-sm border-0 overflow-hidden">
                            <!-- Image Display Area -->
                            <div class="ratio ratio-1x1 bg-light position-relative border-bottom" style="background-color: @Options.BgColorHex !important;">
                                @if (job.Status == PhotoJobState.Completed)
                                {
                                    <img src="/api/batch/preview/@job.JobId?v=@(job.CompletedAt?.Ticks ?? DateTime.UtcNow.Ticks)" alt="@job.FileName" class="w-100 h-100 object-fit-cover" />
                                }
                                else if (job.Status == PhotoJobState.Processing)
                                {
                                    <div class="d-flex flex-column align-items-center justify-content-center h-100 text-primary">
                                        <div class="spinner-border text-primary mb-2" role="status"></div>
                                        <span class="small fw-semibold">Processing AI...</span>
                                    </div>
                                }
                                else if (job.Status == PhotoJobState.Failed)
                                {
                                    <div class="d-flex flex-column align-items-center justify-content-center h-100 text-danger p-3 text-center">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-exclamation-triangle mb-2" viewBox="0 0 16 16">
                                            <path d="M7.938 2.016A.13.13 0 0 1 8.002 2a.13.13 0 0 1 .063.016.15.15 0 0 1 .054.057l6.857 11.667c.036.06.035.124.002.183a.2.2 0 0 1-.054.06.1.1 0 0 1-.066.017H1.146a.1.1 0 0 1-.066-.017.2.2 0 0 1-.054-.06.18.18 0 0 1 .002-.183L7.884 2.073a.15.15 0 0 1 .054-.057m1.044-.45a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767z"/>
                                            <path d="M7.002 12a1 1 0 1 1 2 0 1 1 0 0 1-2 0M7.1 5.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0z"/>
                                        </svg>
                                        <span class="small fw-semibold">Processing Failed</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
                                        <span class="spinner-grow spinner-grow-sm mb-2" role="status"></span>
                                        <span class="small">Queued...</span>
                                    </div>
                                }

                                <!-- Status Badge overlay -->
                                <div class="position-absolute top-0 end-0 m-2">
                                    @switch (job.Status)
                                    {
                                        case PhotoJobState.Completed:
                                            <span class="badge bg-success shadow-sm">Done</span>
                                            break;
                                        case PhotoJobState.Processing:
                                            <span class="badge bg-primary shadow-sm">Working</span>
                                            break;
                                        case PhotoJobState.Failed:
                                            <span class="badge bg-danger shadow-sm">Failed</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary shadow-sm">Queued</span>
                                            break;
                                    }
                                </div>
                            </div>

                            <!-- Card Body / Meta -->
                            <div class="card-body p-2 d-flex flex-column justify-content-between">
                                <div>
                                    <p class="card-text small fw-semibold text-truncate mb-1" title="@job.FileName">
                                        @job.FileName
                                    </p>
                                    @if (job.Status == PhotoJobState.Completed && job.OutputSizeBytes > 0)
                                    {
                                        <p class="text-muted extra-small mb-2" style="font-size: 0.75rem;">
                                            @(Options.TargetWidth)x@(Options.TargetHeight) &bull; @(job.OutputSizeBytes / 1024) KB
                                        </p>
                                    }
                                    else if (job.Status == PhotoJobState.Failed)
                                    {
                                        <p class="text-danger extra-small mb-2" style="font-size: 0.75rem;" title="@job.ErrorMessage">
                                            @job.ErrorMessage
                                        </p>
                                    }
                                </div>

                                <div>
                                    @if (job.Status == PhotoJobState.Completed)
                                    {
                                        <a href="/api/batch/download-single/@job.JobId" download="@job.FileName" class="btn btn-sm btn-outline-primary w-100 py-1">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-download me-1" viewBox="0 0 16 16">
                                                <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5"/>
                                                <path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708z"/>
                                            </svg>
                                            Download
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private ProcessingOptions Options { get; set; } = new();
    private string CurrentBatchId { get; set; } = Guid.NewGuid().ToString("N")[..12];
    private List<PhotoJobStatus> CurrentJobs { get; set; } = new();
    private bool IsUploading { get; set; } = false;
    private PeriodicTimer? _pollTimer;
    private CancellationTokenSource? _cts;

    private int CompletedCount => CurrentJobs.Count(j => j.Status == PhotoJobState.Completed);
    private int ProcessingCount => CurrentJobs.Count(j => j.Status == PhotoJobState.Processing);
    private int FailedCount => CurrentJobs.Count(j => j.Status == PhotoJobState.Failed);
    private bool IsFinished => CurrentJobs.Count > 0 && (CompletedCount + FailedCount) == CurrentJobs.Count;
    private double ProgressPercent => CurrentJobs.Count > 0 
        ? Math.Round((double)(CompletedCount + FailedCount) / CurrentJobs.Count * 100.0, 1) 
        : 0;

    private bool SettingsSavedAlertVisible = false;

    protected override void OnInitialized()
    {
        BatchService.OnJobUpdated += HandleJobUpdated;
        StartPollingTimer();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadSavedSettingsAsync();
        }
    }

    private async Task SaveSettingsAsync()
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(Options);
            await JS.InvokeVoidAsync("localStorage.setItem", "student_id_processor_settings", json);
            SettingsSavedAlertVisible = true;
            StateHasChanged();

            _ = Task.Run(async () =>
            {
                await Task.Delay(3500);
                SettingsSavedAlertVisible = false;
                await InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving settings to localStorage: {ex.Message}");
        }
    }

    private async Task ResetSettingsAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", "student_id_processor_settings");
            Options = new ProcessingOptions();
            SettingsSavedAlertVisible = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error resetting settings: {ex.Message}");
        }
    }

    private async Task LoadSavedSettingsAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", "student_id_processor_settings");
            if (!string.IsNullOrWhiteSpace(json))
            {
                var loaded = System.Text.Json.JsonSerializer.Deserialize<ProcessingOptions>(json);
                if (loaded != null)
                {
                    Options = loaded;
                    StateHasChanged();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading settings from localStorage: {ex.Message}");
        }
    }

    private void SetFramingDefault()
    {
        Options.HeadroomRatio = 0.45;
        Options.FaceHeightMultiplier = 2.35;
    }

    private void SetFramingTight()
    {
        Options.HeadroomRatio = 0.30;
        Options.FaceHeightMultiplier = 1.85;
    }

    private void SetFramingWide()
    {
        Options.HeadroomRatio = 0.50;
        Options.FaceHeightMultiplier = 2.80;
    }

    private async void HandleJobUpdated(PhotoJobStatus updatedJob)
    {
        try
        {
            if (updatedJob.BatchId == CurrentBatchId)
            {
                await InvokeAsync(() =>
                {
                    UpsertJob(updatedJob);
                    StateHasChanged();
                });
            }
        }
        catch
        {
            // Circuit may be disconnected or disposed
        }
    }

    private void UpsertJob(PhotoJobStatus job)
    {
        var idx = CurrentJobs.FindIndex(j => j.JobId == job.JobId);
        if (idx >= 0)
        {
            CurrentJobs[idx] = job;
        }
        else
        {
            CurrentJobs.Add(job);
        }
    }

    private void SetColor(string hex)
    {
        Options.BgColorHex = hex;
    }

    private void CheckModelStatus()
    {
        RefreshBatchStatus();
        StateHasChanged();
    }

    private void RefreshBatchStatus()
    {
        if (string.IsNullOrEmpty(CurrentBatchId)) return;
        var updated = BatchService.GetBatchStatus(CurrentBatchId);
        if (updated.Count > 0)
        {
            CurrentJobs = updated.GroupBy(j => j.JobId).Select(g => g.Last()).ToList();
            StateHasChanged();
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles(500);
        if (files == null || files.Count == 0) return;

        IsUploading = true;
        StateHasChanged();

        // Create fresh batch ID for this new upload
        CurrentBatchId = Guid.NewGuid().ToString("N")[..12];
        CurrentJobs.Clear();

        try
        {
            foreach (var file in files)
            {
                // Max file size: 30 MB per mobile photo
                using var stream = file.OpenReadStream(30 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);

                var job = new BatchPhotoJob
                {
                    JobId = Guid.NewGuid().ToString("N")[..16],
                    BatchId = CurrentBatchId,
                    FileName = file.Name,
                    InputBytes = ms.ToArray(),
                    Options = new ProcessingOptions
                    {
                        TargetWidth = Options.TargetWidth,
                        TargetHeight = Options.TargetHeight,
                        BgColorHex = Options.BgColorHex,
                        OutputJpeg = Options.OutputJpeg,
                        JpegQuality = Options.JpegQuality,
                        TargetDpi = Options.TargetDpi,
                        HeadroomRatio = Options.HeadroomRatio,
                        FaceHeightMultiplier = Options.FaceHeightMultiplier
                    }
                };

                UpsertJob(new PhotoJobStatus
                {
                    JobId = job.JobId,
                    BatchId = job.BatchId,
                    FileName = job.FileName,
                    OriginalSizeBytes = file.Size,
                    Status = PhotoJobState.Queued
                });

                await BatchService.EnqueueJobAsync(job);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error uploading files: {ex.Message}");
        }
        finally
        {
            IsUploading = false;
            StateHasChanged();
        }
    }

    private void StartPollingTimer()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _pollTimer?.Dispose();

        _cts = new CancellationTokenSource();
        _pollTimer = new PeriodicTimer(TimeSpan.FromMilliseconds(800));

        _ = Task.Run(async () =>
        {
            while (!_cts.IsCancellationRequested)
            {
                try
                {
                    if (await _pollTimer.WaitForNextTickAsync(_cts.Token))
                    {
                        if (CurrentJobs.Count > 0 && !IsFinished)
                        {
                            var updated = BatchService.GetBatchStatus(CurrentBatchId);
                            if (updated.Count > 0)
                            {
                                await InvokeAsync(() =>
                                {
                                    CurrentJobs = updated.GroupBy(j => j.JobId).Select(g => g.Last()).ToList();
                                    StateHasChanged();
                                });
                            }
                        }
                    }
                }
                catch (OperationCanceledException)
                {
                    break;
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Polling loop tick exception: {ex.Message}");
                    await Task.Delay(1000, _cts.Token);
                }
            }
        });
    }

    private void ClearBatch()
    {
        CurrentJobs.Clear();
        CurrentBatchId = Guid.NewGuid().ToString("N")[..12];
        StateHasChanged();
    }

    public void Dispose()
    {
        BatchService.OnJobUpdated -= HandleJobUpdated;
        _cts?.Cancel();
        _cts?.Dispose();
        _pollTimer?.Dispose();
    }
}
