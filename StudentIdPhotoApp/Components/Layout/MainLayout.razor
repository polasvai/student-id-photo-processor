@inherits LayoutComponentBase

<div class="min-vh-100 d-flex flex-column bg-light">
    <header class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm sticky-top">
        <div class="container-fluid px-4">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-white fs-4" href="">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" class="bi bi-person-bounding-box" viewBox="0 0 16 16">
                    <path d="M1.5 1a.5.5 0 0 0-.5.5v3a.5.5 0 0 1-1 0v-3A1.5 1.5 0 0 1 1.5 0h3a.5.5 0 0 1 0 1zM11 .5a.5.5 0 0 1 .5-.5h3A1.5 1.5 0 0 1 16 1.5v3a.5.5 0 0 1-1 0v-3a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 1-.5-.5M.5 11a.5.5 0 0 1 .5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 1 0 1h-3A1.5 1.5 0 0 1 0 14.5v-3a.5.5 0 0 1 .5-.5m15 0a.5.5 0 0 1 .5.5v3a1.5 1.5 0 0 1-1.5 1.5h-3a.5.5 0 0 1 0-1h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 1 .5-.5"/>
                    <path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm8-9a3 3 0 1 1-6 0 3 3 0 0 1 6 0"/>
                </svg>
                <span>Student ID Photo Processor</span>
                <span class="badge bg-white text-primary fs-6 fw-normal ms-2">.NET 8 AI</span>
            </a>
            <div class="d-flex align-items-center gap-3 text-white-50">
                <span class="small d-none d-md-inline">BRIA RMBG-1.4 • YuNet Face Detection • SixLabors ImageSharp</span>
            </div>
        </div>
    </header>

    <main class="flex-grow-1 py-4">
        <div class="container-fluid px-4">
            @Body
        </div>
    </main>

    <footer class="bg-white border-top py-3 text-center text-muted small mt-auto">
        <div class="container-fluid">
            <span>Automated Batch Student ID Photo Processor &bull; High Performance .NET 8</span>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" class="alert alert-danger fixed-bottom m-3 shadow" style="display:none;">
    An unhandled error has occurred.
    <a href="" class="reload fw-bold ms-2">Reload</a>
    <a class="dismiss ms-2" style="cursor:pointer">🗙</a>
</div>
